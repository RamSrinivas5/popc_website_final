{
  "name": "popc-appium-ios-e2e",
  "version": "1.0.0",
  "description": "Enterprise Appium iOS E2E Test Framework for POPC Mobile Application",
  "type": "commonjs",
  "scripts": {
    "test": "node runners/testRunner.js",
    "test:auth": "node runners/testRunner.js --suite=auth",
    "test:patient": "node runners/testRunner.js --suite=patient",
    "test:survey": "node runners/testRunner.js --suite=survey",
    "test:dashboard": "node runners/testRunner.js --suite=dashboard",
    "test:regression": "node runners/testRunner.js --suite=regression",
    "report:excel": "node utils/excelReporter.js",
    "report:html": "node utils/htmlReporter.js",
    "report:all": "node utils/generateReports.js",
    "appium:start": "appium --port 4723 --log-level info",
    "appium:check": "curl http://localhost:4723/status",
    "clean": "node -e \"require('fs').rmSync('reports',{recursive:true,force:true});require('fs').rmSync('screenshots',{recursive:true,force:true});\"",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "webdriverio": "^8.36.0",
    "@wdio/appium-service": "^8.36.0",
    "@wdio/cli": "^8.36.0",
    "@wdio/local-runner": "^8.36.0",
    "@wdio/mocha-framework": "^8.36.0",
    "@wdio/spec-reporter": "^8.36.0",
    "appium": "^2.11.0",
    "appium-xcuitest-driver": "^7.0.0",
    "exceljs": "^4.4.0",
    "chai": "^5.1.2",
    "dotenv": "^16.4.5",
    "winston": "^3.17.0",
    "fs-extra": "^11.2.0",
    "moment": "^2.30.1",
    "uuid": "^11.1.0",
    "axios": "^1.7.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
