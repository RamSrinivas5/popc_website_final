# Test Logs (keep reports but not raw logs)
selenium-tests/logs/*.log
appium-tests/logs/*.log

# Screenshots (too large for git)
selenium-tests/screenshots/
appium-tests/screenshots/

# Raw result JSON (regenerated each run)
selenium-tests/reports/raw-results.json
appium-tests/reports/raw-results.json

